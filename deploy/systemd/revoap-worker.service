# RevoAp Worker - durable LLM pipeline runner (Phase 2).
#
# Drop-in template for systemd-based deployments. Edit the placeholders
# (User, Group, WorkingDirectory, ExecStart, Environment files) for
# your host, copy to /etc/systemd/system/, then:
#
#   sudo systemctl daemon-reload
#   sudo systemctl enable revoap-worker.service
#   sudo systemctl start  revoap-worker.service
#   sudo systemctl status revoap-worker.service
#   sudo journalctl -u revoap-worker.service -f
#
# Logs: the worker emits one JSON line per event. `info`/`debug` go to
# STDOUT, `warn`/`error` go to STDERR; both reach journald via systemd
# and can be piped through `jq` for filtering:
#
#   journalctl -u revoap-worker.service -f -o cat | jq .
#
# Multiple workers: use the provided revoap-worker@.service template
# (revoap-worker@1, revoap-worker@2, ...). The DB row lock +
# FOR UPDATE SKIP LOCKED guarantees no two workers can acquire the
# same job.

[Unit]
Description=RevoAp Worker - durable LLM pipeline runner
Documentation=https://github.com/paulmann/AI-RevoAp
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
# Run as the same user the RevoAp PHP-FPM pool already runs as so
# logs/cache/runtime directories stay writable.
User=www-data
Group=www-data
WorkingDirectory=/var/www/revoap

# Worker settings. The pool reads them from the environment so the
# poll tempo can be tuned without editing the unit. EnvironmentFile
# (/etc/revoap/worker.env) overrides these inline defaults, e.g.
# WORKER_SLEEP=5 shifts the worker to a quiet-hours tempo.
Environment=WORKER_SLEEP=1
Environment=WORKER_STALE_AFTER=300
Environment=WORKER_MAX_JOBS=0
Environment=WORKER_BACKOFF_BASE=30
Environment=WORKER_BACKOFF_MAX=900
Environment=WORKER_MAX_ATTEMPTS=3

# Daemon mode. Templated values let ops tune the tempo per unit or via
# the env file: interactive mode WORKER_SLEEP=1, quiet hours=5 (see
# docs/WorkerArchitecture.md "Poll tempo").
ExecStart=/usr/bin/php /var/www/revoap/bin/revoap-worker.php --loop --sleep=${WORKER_SLEEP} --stale-after=${WORKER_STALE_AFTER} --max-jobs=${WORKER_MAX_JOBS} --backoff-base=${WORKER_BACKOFF_BASE} --backoff-max=${WORKER_BACKOFF_MAX} --max-attempts=${WORKER_MAX_ATTEMPTS}

# Runtime environment: tempo controls (WORKER_SLEEP, WORKER_STALE_AFTER,
# WORKER_MAX_JOBS, WORKER_BACKOFF_BASE, WORKER_BACKOFF_MAX,
# WORKER_MAX_ATTEMPTS) plus secrets the bundled config.php may read at
# boot (e.g. REVOAP_ADMIN_TOKEN). Never commit this file.
EnvironmentFile=-/etc/revoap/worker.env

# Restart on any non-zero exit so a transient DB outage does not
# require manual intervention. The systemd default 100ms RestartSec
# would flood logs on a hard failure, so back it off to 5s.
Restart=always
RestartSec=5

# Hardening. Drop privileges aggressively - the worker only needs
# /var/www/revoap (read + cache write) and outbound HTTPS.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true

# Stream logs to journald. systemd will tag every line with the unit
# name so `journalctl -u revoap-worker.service` works out of the box.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=revoap-worker

# Graceful shutdown: PipelineJobRunner reacts to SIGTERM by finishing
# the current cycle, persisting state, then exiting.
KillSignal=SIGTERM
TimeoutStopSec=600

[Install]
WantedBy=multi-user.target
