# RevoAp worker runtime settings (template).
#
# Copy to /etc/revoap/worker.env and adjust per host:
#
#   sudo mkdir -p /etc/revoap
#   sudo cp deploy/systemd/worker.env.example /etc/revoap/worker.env
#   sudo chown root:root /etc/revoap/worker.env
#   sudo chmod 640 /etc/revoap/worker.env
#   sudo systemctl daemon-reload
#   sudo systemctl restart 'revoap-worker@*' revoap-worker.service
#
# The systemd units (revoap-worker.service and
# revoap-worker@.service) read these values via EnvironmentFile
# and pass them as CLI flags to bin/revoap-worker.php. Values not
# listed here fall back to the inline Environment= defaults in the
# unit, which match Config::jobsRecoveryPolicy().
#
# SECURITY: do not commit a real worker.env - this file may also carry
# secrets (see REVOAP_ADMIN_TOKEN below).

# Poll interval between empty-queue polls in --loop mode (seconds).
# Interactive (users around): 1. Quiet hours (night/weekend): 5.
WORKER_SLEEP=1

# Heartbeat threshold: jobs whose heartbeat is older than this are
# reclaimed (auto-requeued while the retry budget lasts).
WORKER_STALE_AFTER=300

# Stop after N processed jobs, even in --loop mode (0 = no cap).
WORKER_MAX_JOBS=0

# Auto-recovery retry/backoff policy (overrides
# Config::jobsRecoveryPolicy() defaults for the worker process).
WORKER_BACKOFF_BASE=30
WORKER_BACKOFF_MAX=900
WORKER_MAX_ATTEMPTS=3

# Optional: secrets the bundled config.php reads at boot.
# Keep it unset unless the deployment requires an env-provided token.
# REVOAP_ADMIN_TOKEN=
