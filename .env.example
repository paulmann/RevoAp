# RevoAp environment variable template
# Copy to .env or export directly. Values here override empty config.php
# entries but are overridden by .{provider}.key files.

BOTHUB_API_KEY=
OPENROUTER_API_KEY=

# Admin token (canonical). The deprecated legacy alias OPEN_CORUM_ADMIN_TOKEN
# is still accepted with a warning; prefer REVOAP_ADMIN_TOKEN.
# REVOAP_ADMIN_TOKEN=$(openssl rand -hex 32)

# Optional database overrides
# DB_DSN=mysql:host=localhost;dbname=opencorum;charset=utf8mb4
# DB_USER=root
# DB_PASS=